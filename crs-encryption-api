const express = require('express');
const crypto = require('crypto');
const app = express();
const PORT = process.env.PORT || 3000;

app.use(express.json({ limit: '10mb' }));

app.use((req, res, next) => {
  res.header('Access-Control-Allow-Origin', '*');
  res.header('Access-Control-Allow-Headers', 'Content-Type');
  res.header('Access-Control-Allow-Methods', 'POST, GET, OPTIONS');
  if (req.method === 'OPTIONS') {
    return res.sendStatus(200);
  }
  next();
});

app.get('/', (req, res) => {
  res.json({ status: 'Active', message: 'CRS Encryption API is running' });
});

app.post('/encrypt', (req, res) => {
  try {
    const data = req.body;
    const result = cryptPayload(data);
    res.json(result);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

function cryptPayload(data) {
  const aesKey = crypto.randomBytes(32);
  const aesIv = crypto.randomBytes(16);
  
  const cipher = crypto.createCipheriv('aes-256-cbc', aesKey, aesIv);
  let encrypted = cipher.update(JSON.stringify(data), 'utf8', 'base64');
  encrypted += cipher.final('base64');
  
  const PUBLIC_KEY = `-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAoznRyEpSBHU0z9+HEB8m
/r3+VGL8cbHHijTxCwA7IzB9W5gcU+4lF2kpCHbpq1C7YiUl/1h2q/TGkR7gtVam
qznco6QLCLUg2kckHat2XnH83t1qySPsDQhX3tafOuyOUrGpzxeirFM/Ht+eJM3G
//asnMwU5ex6ALnHGqV0CEUMlzabPTyZYZTT2iv/tKvTaQ1YAfqCEnR2iHaE0BO+
vGL0Cr1mDndFPoXaN3EPdmE4tYewXGKWDAcmxpRMl49GiMGHIgn1rmJCvpS9K/TW
Ekz+giUrypFBIBgATSkbU6q+ruy9sjVaYVxZjexJmy9nOW3Gghi5HeV6htqvwFKx
WQIDAQAB
-----END PUBLIC KEY-----`;
  
  const encryptedKey = crypto.publicEncrypt({
    key: PUBLIC_KEY,
    padding: crypto.constants.RSA_PKCS1_OAEP_PADDING,
    oaepHash: 'sha256'
  }, aesKey);
  
  return {
    signature: encryptedKey.toString('base64'),
    seed: aesIv.toString('base64'),
    meta: encrypted
  };
}

app.listen(PORT, () => {
  console.log(`Encryption API running on port ${PORT}`);
});
